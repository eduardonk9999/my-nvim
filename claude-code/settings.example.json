{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/nvim-open.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
